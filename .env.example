# Set this only after the official production domain is confirmed.
# Must be the HTTPS origin with no path, query, or fragment.
NEXT_PUBLIC_SITE_URL=

# Use the same variable names with environment-scoped values:
# - .env.local and Vercel Preview: dedicated test Supabase project
# - Vercel Production: operational Supabase project
# The server rejects a target that does not match the deployment environment.
SUPABASE_DATA_TARGET=test
SUPABASE_URL=
# Browser-safe Supabase project URL and publishable key for Auth sessions.
# Match NEXT_PUBLIC_SUPABASE_URL to SUPABASE_URL for the selected environment.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase > Project Settings > API Keys > Publishable key (safe for browser use).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Create this in Supabase > Project Settings > API Keys. Never add NEXT_PUBLIC_ to this key.
SUPABASE_SECRET_KEY=
# Comma- or whitespace-separated admin email addresses. Keep this server-only.
ADMIN_EMAIL_ALLOWLIST=
